# ── Base de datos (PostgreSQL) ──
# URL usada por la app (puede ir por pooler en producción).
DATABASE_URL="postgresql://postgres:PASSWORD@localhost:5432/dfly"
# Conexión directa para el CLI de Prisma (migraciones, seed).
DIRECT_URL="postgresql://postgres:PASSWORD@localhost:5432/dfly"

# ── Auth.js ──
# Generar con: npx auth secret
AUTH_SECRET=""
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Solo en producción si el host no lo infiere:
# AUTH_URL="https://dfly.pe"

# ── WhatsApp Cloud API (Meta) ──
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_APP_SECRET=""
WHATSAPP_VERIFY_TOKEN=""
# Número (E.164) del dueño de Dfly que recibe cada pedido completo.
ADMIN_WHATSAPP_TO="+593990000000"

# ── Seguridad de pedidos y crons ──
# Firma HMAC de los botones Aceptar/Rechazar.
ORDER_ACTION_SECRET=""
CRON_SECRET=""
ORDER_RESPONSE_TIMEOUT_MIN="10"

# Solo para el seed (opcional)
SEED_ADMIN_EMAIL=""
SEED_ADMIN_PASSWORD=""

# Costo de envío fijo en centavos de USD ($2.00)
DELIVERY_FEE_CENTS="200"
# Versión de la Graph API de Meta
WHATSAPP_API_VERSION="v25.0"

# ── Fotos de comercios y productos (Supabase Storage) ──
# Sin estas variables, en desarrollo las fotos se guardan en public/uploads.
# El bucket debe ser público (lectura); la subida usa la service role key, solo en el servidor.
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="dfly"
