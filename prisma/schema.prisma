generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ───────────── Identidad (modelos de @auth/prisma-adapter + extensiones) ─────────────

enum Role {
  CUSTOMER
  ADMIN
}

model User {
  id              String    @id @default(cuid())
  name            String?
  email           String    @unique
  emailVerified   DateTime?
  image           String?
  /// Hash bcrypt. Null para usuarios que solo entran por OAuth.
  password        String?
  role            Role      @default(CUSTOMER)
  /// Teléfono en formato E.164 (p. ej. +593991234567). Obligatorio antes de pedir.
  phone           String?
  /// Consentimiento explícito para recibir mensajes de WhatsApp (requisito de Meta).
  whatsappOptInAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  accounts  Account[]
  sessions  Session[]
  addresses Address[]
  orders    Order[]

  @@map("users")
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
  @@index([userId])
  @@map("accounts")
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("sessions")
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
  @@map("verification_tokens")
}

model Address {
  id        String   @id @default(cuid())
  userId    String
  label     String
  line      String
  city      String   @default("Otavalo")
  /// Barrio o sector (p. ej. "Centro", "San Juan").
  sector    String
  reference String?
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

// ───────────── Catálogo ─────────────

enum StoreCategory {
  RESTAURANT
  MARKET
  PHARMACY
  LIQUOR
  PETS
}

model Store {
  id            String        @id @default(cuid())
  slug          String        @unique
  name          String
  description   String?
  category      StoreCategory
  city          String        @default("Otavalo")
  sector        String
  etaMinutes    Int
  /// Número E.164 del comercio. NUNCA se expone al cliente.
  whatsappPhone String
  imageUrl      String?
  isActive      Boolean       @default(true)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  products Product[]
  orders   Order[]

  @@index([city, category, isActive])
  @@map("stores")
}

model Product {
  id          String   @id @default(cuid())
  storeId     String
  name        String
  description String?
  /// Precio en centavos de USD (moneda oficial de Ecuador).
  priceCents  Int
  imageUrl    String?
  isAvailable Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  store      Store       @relation(fields: [storeId], references: [id], onDelete: Cascade)
  orderItems OrderItem[]

  @@index([storeId, isAvailable])
  @@map("products")
}

// ───────────── Pedidos ─────────────

enum OrderStatus {
  PENDING
  SENT_TO_STORE
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum PaymentMethod {
  CASH
  TRANSFER
}

enum OrderActor {
  CUSTOMER
  STORE
  ADMIN
  SYSTEM
}

model Order {
  id               String        @id @default(cuid())
  /// Código corto legible (p. ej. A7K3) usado en URLs y mensajes.
  publicCode       String        @unique
  userId           String
  storeId          String
  status           OrderStatus   @default(PENDING)
  subtotalCents    Int
  deliveryFeeCents Int
  totalCents       Int
  notes            String?
  paymentMethod    PaymentMethod
  // Snapshot de los datos del cliente al momento del pedido (solo para Dfly, nunca al comercio).
  customerName     String
  customerPhone    String
  deliveryAddress  String
  respondedAt      DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt

  user     User               @relation(fields: [userId], references: [id])
  store    Store              @relation(fields: [storeId], references: [id])
  items    OrderItem[]
  events   OrderStatusEvent[]
  messages OutboxMessage[]

  @@index([status, createdAt])
  @@index([userId, createdAt])
  @@index([storeId])
  @@map("orders")
}

model OrderItem {
  id             String   @id @default(cuid())
  orderId        String
  productId      String
  nameSnapshot   String
  unitPriceCents Int
  quantity       Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model OrderStatusEvent {
  id        String       @id @default(cuid())
  orderId   String
  from      OrderStatus?
  to        OrderStatus
  actor     OrderActor
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_status_events")
}

// ───────────── Mensajería (outbox + webhook) ─────────────

enum OutboxKind {
  ADMIN_NEW_ORDER
  STORE_REQUEST
  ADMIN_RESULT
  CUSTOMER_RESULT
  ADMIN_EXPIRED
  CUSTOMER_CANCELLED
  STORE_CANCELLED
}

enum OutboxStatus {
  PENDING
  SENT
  FAILED
  /// No se envió porque el pedido se canceló antes (p. ej. STORE_REQUEST aún en cola).
  SKIPPED
}

model OutboxMessage {
  id            String       @id @default(cuid())
  kind          OutboxKind
  orderId       String
  to            String
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  nextAttemptAt DateTime     @default(now())
  waMessageId   String?
  lastError     String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([status, nextAttemptAt])
  @@index([orderId])
  @@map("outbox_messages")
}

model WebhookEvent {
  id          String   @id @default(cuid())
  /// ID del mensaje entrante de WhatsApp; único para garantizar idempotencia.
  waMessageId String   @unique
  receivedAt  DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("webhook_events")
}

// ───────────── Seguridad ─────────────

/// Contador de ventana fija para rate limiting. `key` = "<política>:<sha256 del identificador>".
model RateLimitBucket {
  key       String   @id
  count     Int
  resetAt   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([resetAt])
  @@map("rate_limit_buckets")
}
